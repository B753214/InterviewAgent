# Application
APP_NAME=InterviewAgent
APP_VERSION=0.1.0
DEBUG=true

# Database (async SQLAlchemy)
DATABASE_URL=sqlite+aiosqlite:///./interview.db

# Redis (reserved)
REDIS_URL=redis://localhost:6379/0

# Auth (reserved)
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# LLM — OpenAI-compatible (DeepSeek / 其它兼容接口)
LLM_PROVIDER=deepseek
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_BASE_URL=https://api.deepseek.com/v1
DEFAULT_LLM_MODEL=deepseek-chat
DEFAULT_LLM_TIMEOUT_SECONDS=60

# Agent-specific model overrides (empty = use DEFAULT_LLM_MODEL)
RESUME_ANALYZER_MODEL=
JOB_ANALYZER_MODEL=
QUESTION_ROUTER_MODEL=
INTERVIEWER_MODEL=
ASSESSMENT_MODEL=
PDF_VISION_AGENT_MODEL=

# Embedding — DashScope (RAG / M4)
EMBEDDING_PROVIDER=dashscope
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
VECTOR_STORE_PATH=./data/vectorstore

# CORS — JSON list string for pydantic-settings
CORS_ORIGINS=["*"]
